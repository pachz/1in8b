# Umami Cloud website ID (public; appears in the page as data-website-id)
UMAMI_WEBSITE_ID=

# Optional: comma-separated hostnames Umami should accept.
# Leave empty to track every host (useful for *.vercel.app + custom domain).
# Example: 1in8b.ir,www.1in8b.ir,1in8b.vercel.app
UMAMI_DOMAINS=

# Turso (libSQL) — live presence, posts, free Keep, lives, move, homes, memorials
# Without these, features still work in-process (lost on cold start / Vercel cold starts).
STORAGE_TURSO_DATABASE_URL=
STORAGE_TURSO_AUTH_TOKEN=
