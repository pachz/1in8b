# Umami Cloud website ID (public; appears in the page as data-website-id)
UMAMI_WEBSITE_ID=

# Optional: comma-separated hostnames Umami should accept.
# Leave empty to track every host (useful for *.vercel.app + custom domain).
# Example: 1in8b.ir,www.1in8b.ir,1in8b.vercel.app
UMAMI_DOMAINS=

# Turso (libSQL) — REQUIRED for posts, memorials, Keep, lives, move, homes, world, auth
# On first request, gallery posts/memorials are seeded once from data/api-seed.json.
STORAGE_TURSO_DATABASE_URL=
STORAGE_TURSO_AUTH_TOKEN=

# —— Auth OTP (email + phone) ——————————————————————————
# Pepper for hashing OTP codes (long random string). Required for /api/auth/*.
AUTH_OTP_PEPPER=

# Kavenegar SMS verify/lookup (phone OTP)
KAVENEGAR_TOKEN=
KAVENEGAR_TEMPLATE=1in8b-verify

# Outbound proxy for Iranian APIs (Kavenegar, etc.) from Vercel/non-IR hosts.
# Final request URL becomes: {proxy}/{https://api.kavenegar.com/...}
# OUTBOUND_PROXY_URL=https://your-proxy.example
# Legacy alias also accepted: KAVENEGAR_PROXY_URL=


# Resend email (email OTP)
RESEND_API_KEY=
AUTH_EMAIL_FROM=1in8b <noreply@1in8b.ir>

# Local only: when true, /api/auth/start returns { devCode } and skips SMS/email send
# AUTH_OTP_DEV=1

# —— Admin (/admin/) ————————————————————————————————————
# Plain password for the DB browser. Leave empty to disable /api/admin/*.
ADMIN_PASSWORD=
