{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "installCommand": "npm install --omit=dev --ignore-scripts",
  "functions": {
    "api/**/*.js": {
      "includeFiles": "{data/api-seed.json,package.json,lib/**}",
      "maxDuration": 15
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/fa/",
      "permanent": true
    },
    {
      "source": "/:lang(en|ko|ja|zh|zh-hans|vi|fr|th|es|de|pt|ru|tr|id|it|ar|fa)/m/:id.png",
      "destination": "/og-en.png",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/:lang(en|ko|ja|zh|zh-hans|vi|fr|th|es|de|pt|ru|tr|id|it|ar|fa)/m/:path*",
      "destination": "/:lang/index.html"
    },
    {
      "source": "/:lang(en|ko|ja|zh|zh-hans|vi|fr|th|es|de|pt|ru|tr|id|it|ar|fa)/pass/:path*",
      "destination": "/:lang/index.html"
    },
    {
      "source": "/:lang(en|ko|ja|zh|zh-hans|vi|fr|th|es|de|pt|ru|tr|id|it|ar|fa)/keep/:path*",
      "destination": "/:lang/index.html"
    },
    {
      "source": "/:lang(en|ko|ja|zh|zh-hans|vi|fr|th|es|de|pt|ru|tr|id|it|ar|fa)/s/:path*",
      "destination": "/:lang/index.html"
    },
    {
      "source": "/:lang(en|ko|ja|zh|zh-hans|vi|fr|th|es|de|pt|ru|tr|id|it|ar|fa)/h/:path*",
      "destination": "/:lang/index.html"
    }
  ],
  "headers": [
    {
      "source": "/a/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/labw.(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
